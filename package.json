{
  "name": "aigak",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env --import tsx server/index.ts",
    "build": "tsc --noEmit && vite build",
    "start": "NODE_ENV=production node --env-file-if-exists=.env --import tsx server/index.ts",
    "test": "node --import tsx --test tests/*.test.ts",
    "setup:ocr": "node scripts/setup-ocr.mjs",
    "eval:ai": "node --env-file-if-exists=.env --import tsx scripts/eval-ai.ts"
  },
  "dependencies": {
    "@fontsource/golos-text": "^5.3.0",
    "@vitejs/plugin-react": "latest",
    "cheerio": "latest",
    "docx": "^9.10.0",
    "docxtemplater": "^3.71.0",
    "express": "^5.1.0",
    "ipaddr.js": "^2.2.0",
    "jszip": "^3.10.1",
    "lucide-react": "latest",
    "multer": "^2.0.2",
    "pdfjs-dist": "latest",
    "pizzip": "^3.3.0",
    "playwright": "latest",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tesseract.js": "^6.0.1",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/multer": "^2.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "tsx": "latest",
    "typescript": "^5.8.0",
    "vite": "latest"
  }
}
