{
  "name": "aigak",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env --import tsx server/index.ts",
    "build": "tsc --noEmit && vite build",
    "start": "NODE_ENV=production node --env-file-if-exists=.env --import tsx server/index.ts",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:ui": "npm run build && node scripts/smoke-ui.mjs",
    "setup:ocr": "node scripts/setup-ocr.mjs",
    "eval:ai": "node --env-file-if-exists=.env --import tsx scripts/eval-ai.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "check:architecture": "node scripts/check-architecture.mjs",
    "check": "npm run format:check && npm run lint && npm run check:architecture && npm test && npm run build"
  },
  "dependencies": {
    "@fontsource/golos-text": "^5.3.0",
    "@vitejs/plugin-react": "latest",
    "cheerio": "latest",
    "docx": "^9.10.0",
    "docxtemplater": "^3.71.0",
    "express": "^5.1.0",
    "ipaddr.js": "^2.2.0",
    "jszip": "^3.10.1",
    "lucide-react": "latest",
    "multer": "^2.0.2",
    "pdfjs-dist": "latest",
    "pizzip": "^3.3.0",
    "playwright": "latest",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tesseract.js": "^6.0.1",
    "tldts": "^7.4.18",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/express": "^5.0.0",
    "@types/multer": "^2.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "eslint": "10.12.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "prettier": "3.9.10",
    "tsx": "latest",
    "typescript": "^5.8.0",
    "typescript-eslint": "8.71.2",
    "vite": "latest"
  }
}
