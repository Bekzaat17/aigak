PORT=4317
DATA_DIR=./data
# Optional. Advanced/Pro send text to configured AI profiles; Basic makes zero model requests.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# If omitted, Playwright uses its installed Chromium. Chrome can also be used:
BROWSER_CHANNEL=chrome
# Optional server-side model routing. See config/ai.example.json.
# AIGAK_AI_CONFIG=./config/ai.example.json
# LITELLM_API_KEY=

# PostgreSQL: set a private password, then npm run db:up.
STORAGE_DRIVER=postgres
POSTGRES_PASSWORD=replace-with-a-private-password
POSTGRES_PORT=5432
DATABASE_URL=postgres://aigak:replace-with-a-private-password@127.0.0.1:5432/aigak
